<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-ink">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavigation">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %></li>
            <li class="nav-item"><%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %></li>
            <li class="nav-item"><%= link_to "Visit the workshop", visit_path, class: "nav-link #{'active' if current_page?(visit_path)}" %></li>
            <li class="nav-item"><%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %></li>
          </ul>
        </div>
      </div>
    </nav>
    <main class="flex-grow-1"><%= yield %></main>
    <footer class="py-4 bg-paper border-top">
      <div class="container small text-muted">Wheelhouse Bicycle Workshop · Fair prices, careful work.</div>
    </footer>
  </body>
</html>
