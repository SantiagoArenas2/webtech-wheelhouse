<% content_for :title, "Customers | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">The workshop's people</p>
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Customers</h1>
    <%= link_to "New customer", new_customer_path, class: "btn btn-coral" %>
  </div>

  <% if @customers.empty? %>
    <p class="lead mt-4">No customers yet.</p>
  <% else %>
    <div class="table-responsive mt-4">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Phone</th>
          </tr>
        </thead>
        <tbody>
          <% @customers.each do |customer| %>
            <tr>
              <td><%= link_to customer.full_name, customer_path(customer) %></td>
              <td><%= customer.phone %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
