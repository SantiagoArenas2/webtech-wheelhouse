<% content_for :title, "#{@customer.full_name} | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">Customer</p>
  <h1><%= @customer.full_name %></h1>
  <p class="lead"><%= @customer.phone %></p>

  <h2 class="h4 mt-5">Bikes</h2>
  <% if @bikes.empty? %>
    <p class="text-muted">No bikes on record for this customer.</p>
  <% else %>
    <div class="table-responsive mt-3">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Bike</th>
            <th scope="col">Serial number</th>
            <th scope="col">Owner</th>
          </tr>
        </thead>
        <tbody>
          <%= render @bikes %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= link_to "New bike for this customer", new_bike_path(customer_id: @customer.id), class: "btn btn-outline-primary" %>
    <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", customer_path(@customer), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete #{@customer.full_name}? This can't be undone." } %>
  </div>

  <%= link_to "← Back to customers", customers_path, class: "d-inline-block mt-3" %>
</section>
