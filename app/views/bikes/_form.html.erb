<%= form_with model: bike, class: "row g-3" do |f| %>
  <%= render "shared/error_messages", object: bike %>

  <div class="col-md-4">
    <%= f.label :brand, class: "form-label" %>
    <%= f.text_field :brand, class: "form-control #{"is-invalid" if bike.errors[:brand].any?}" %>
    <% bike.errors[:brand].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-4">
    <%= f.label :model, class: "form-label" %>
    <%= f.text_field :model, class: "form-control #{"is-invalid" if bike.errors[:model].any?}" %>
    <% bike.errors[:model].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-4">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: "form-control #{"is-invalid" if bike.errors[:serial_number].any?}" %>
    <% bike.errors[:serial_number].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-6">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, @customers, :id, :full_name, { include_blank: true }, class: "form-select #{"is-invalid" if bike.errors[:customer_id].any?}" %>
    <% bike.errors[:customer_id].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit class: "btn btn-coral" %>
    <%= link_to "Cancel", (bike.persisted? ? bike : bikes_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
