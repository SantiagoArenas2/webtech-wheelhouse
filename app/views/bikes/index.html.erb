<% content_for :title, "Bikes | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">On the rack and on the road</p>
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Bikes</h1>
    <%= link_to "New bike", new_bike_path, class: "btn btn-coral" %>
  </div>

  <% if @bikes.empty? %>
    <p class="lead mt-4">No bikes yet.</p>
  <% else %>
    <div class="table-responsive mt-4">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Bike</th>
            <th scope="col">Serial number</th>
            <th scope="col">Owner</th>
          </tr>
        </thead>
        <tbody>
          <%= render @bikes %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
