<% content_for :title, "#{@bike.brand} #{@bike.model} | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">Bike</p>
  <h1><%= @bike.brand %> <%= @bike.model %></h1>
  <p class="lead">Serial number <%= @bike.serial_number %></p>
  <p>Owned by <%= link_to @bike.customer.full_name, customer_path(@bike.customer) %></p>

  <h2 class="h4 mt-5">Repairs</h2>
  <% if @repair_jobs.empty? %>
    <p class="text-muted">This bike has never been in for a repair.</p>
  <% else %>
    <div class="table-responsive mt-3">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Repair</th>
            <th scope="col">Bike</th>
            <th scope="col">Customer</th>
            <th scope="col">Photo</th>
            <th scope="col">Diagnosis</th>
            <th scope="col">Status</th>
            <th scope="col">Promised by</th>
          </tr>
        </thead>
        <tbody>
          <%= render @repair_jobs %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= link_to "New repair for this bike", new_repair_path(bike_id: @bike.id), class: "btn btn-outline-primary" %>
    <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", bike_path(@bike), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete #{@bike.serial_number}? This can't be undone." } %>
  </div>

  <%= link_to "← Back to bikes", bikes_path, class: "d-inline-block mt-3" %>
</section>
