<% content_for :title, "Services | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">The workshop wall</p>
  <h1>Services and prices</h1>
  <p class="lead col-lg-8">A straightforward list of the jobs we do. Prices are starting prices and we will talk through anything unusual first.</p>

  <% if @services.empty? %>
    <p class="text-muted mt-4">No services published yet.</p>
  <% else %>
    <div class="table-responsive mt-4">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Service</th>
            <th scope="col" class="text-end">From</th>
          </tr>
        </thead>
        <tbody>
          <% @services.each do |service| %>
            <tr>
              <td><%= link_to service.name, service_path(service) %></td>
              <td class="text-end fw-semibold"><%= format_money(service.list_price) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
