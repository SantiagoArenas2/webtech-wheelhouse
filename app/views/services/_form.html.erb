<%= form_with model: service, url: (service.persisted? ? service_path(service) : services_path), class: "row g-3" do |f| %>
  <%= render "shared/error_messages", object: service %>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{"is-invalid" if service.errors[:name].any?}" %>
    <% service.errors[:name].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-3">
    <%= f.label :list_price, "Price", class: "form-label" %>
    <%= f.number_field :list_price, step: 0.01, class: "form-control #{"is-invalid" if service.errors[:list_price].any?}" %>
    <% service.errors[:list_price].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-3">
    <%= f.label :price_list_id, "Price list", class: "form-label" %>
    <%= f.collection_select :price_list_id, @price_lists, :id, :year, { include_blank: true }, class: "form-select #{"is-invalid" if service.errors[:price_list_id].any?}" %>
    <% service.errors[:price_list_id].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit class: "btn btn-coral" %>
    <%= link_to "Cancel", (service.persisted? ? service : services_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
