<% content_for :title, "Create account | Wheelhouse" %>
<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <p class="eyebrow">Workshop team</p>
      <h1 class="h2 mb-4">Create an account</h1>
      <%= render "shared/error_messages", object: @user %>

      <%= form_with model: @user, class: "row g-3" do |f| %>
        <div class="col-12">
          <%= f.label :email_address, "Email address", class: "form-label" %>
          <%= f.email_field :email_address, autofocus: true, autocomplete: "email", required: true,
            class: "form-control #{"is-invalid" if @user.errors[:email_address].any?}" %>
          <% @user.errors[:email_address].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
        </div>

        <div class="col-12">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 10,
            class: "form-control #{"is-invalid" if @user.errors[:password].any?}" %>
          <% @user.errors[:password].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
          <div class="form-text">Use at least 10 characters.</div>
        </div>

        <div class="col-12">
          <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "form-control #{"is-invalid" if @user.errors[:password_confirmation].any?}" %>
          <% @user.errors[:password_confirmation].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
        </div>

        <div class="col-12"><%= f.submit "Create account", class: "btn btn-coral" %></div>
      <% end %>
      <p class="mt-4 mb-0">Already have an account? <%= link_to "Sign in", new_session_path %></p>
    </div>
  </div>
</section>
