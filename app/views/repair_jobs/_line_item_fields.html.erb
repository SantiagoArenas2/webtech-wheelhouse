<div class="row g-2 align-items-start border-bottom pb-3 mb-3">
  <div class="col-md-4">
    <%= f.label :service_catalogue_item_id, "Service", class: "form-label" %>
    <%= f.collection_select :service_catalogue_item_id, @services, :id, :name, { include_blank: true }, class: "form-select #{"is-invalid" if f.object.errors[:service_catalogue_item_id].any?}" %>
  </div>
  <div class="col-md-2">
    <%= f.label :quoted_price, "Quoted", class: "form-label" %>
    <%= f.number_field :quoted_price, step: 0.01, class: "form-control #{"is-invalid" if f.object.errors[:quoted_price].any?}" %>
    <% f.object.errors[:quoted_price].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>
  <div class="col-md-2">
    <%= f.label :actual_price, "Charged", class: "form-label" %>
    <%= f.number_field :actual_price, step: 0.01, class: "form-control #{"is-invalid" if f.object.errors[:actual_price].any?}" %>
    <% f.object.errors[:actual_price].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>
  <div class="col-md-2">
    <%= f.label :approved_by_customer, "Approved", class: "form-label" %>
    <%= f.select :approved_by_customer, [ [ "—", nil ], [ "Yes", true ], [ "No", false ] ], {}, class: "form-select" %>
  </div>
  <div class="col-md-2">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_field :notes, class: "form-control" %>
  </div>
  <% if f.object.persisted? %>
    <div class="col-12">
      <div class="form-check">
        <%= f.check_box :_destroy, class: "form-check-input" %>
        <%= f.label :_destroy, "Remove this line", class: "form-check-label small text-danger" %>
      </div>
    </div>
  <% end %>
</div>
