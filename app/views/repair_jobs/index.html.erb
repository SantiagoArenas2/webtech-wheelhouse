<% content_for :title, "Repairs | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">On the bench</p>
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Repairs</h1>
    <%= link_to "New repair", new_repair_path, class: "btn btn-coral" %>
  </div>

  <% if @repair_jobs.empty? %>
    <p class="lead mt-4">No repairs yet.</p>
  <% else %>
    <div class="table-responsive mt-4">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Repair</th>
            <th scope="col">Bike</th>
            <th scope="col">Customer</th>
            <th scope="col">Photo</th>
            <th scope="col">Diagnosis</th>
            <th scope="col">Status</th>
            <th scope="col">Promised by</th>
          </tr>
        </thead>
        <tbody>
          <%= render @repair_jobs %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
