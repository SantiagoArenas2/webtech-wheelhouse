<% content_for :title, "Staff | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">Behind the counter and on the bench</p>
  <h1>Staff</h1>

  <% if @staff_members.empty? %>
    <p class="lead mt-4">No staff on record.</p>
  <% else %>
    <div class="table-responsive mt-4">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Role</th>
          </tr>
        </thead>
        <tbody>
          <% @staff_members.each do |staff_member| %>
            <tr>
              <td><%= link_to staff_member.full_name, staff_member_path(staff_member) %></td>
              <td class="text-capitalize"><%= staff_member.role %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
