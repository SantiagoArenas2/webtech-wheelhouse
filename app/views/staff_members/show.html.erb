<% content_for :title, "#{@staff_member.full_name} | Wheelhouse" %>
<section class="container py-5">
  <p class="eyebrow">Staff</p>
  <h1><%= @staff_member.full_name %></h1>
  <p class="lead text-capitalize"><%= @staff_member.role %></p>

  <h2 class="h4 mt-5">Repairs received</h2>
  <% if @repair_jobs.empty? %>
    <p class="text-muted">No repairs logged under this staff member yet.</p>
  <% else %>
    <div class="table-responsive mt-3">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Repair</th>
            <th scope="col">Bike</th>
            <th scope="col">Customer</th>
            <th scope="col">Status</th>
            <th scope="col">Promised by</th>
          </tr>
        </thead>
        <tbody>
          <%= render @repair_jobs %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= link_to "Edit", edit_staff_member_path(@staff_member), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", staff_member_path(@staff_member), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete #{@staff_member.full_name}? This can't be undone." } %>
  </div>

  <%= link_to "← Back to staff", staff_members_path, class: "d-inline-block mt-3" %>
</section>
