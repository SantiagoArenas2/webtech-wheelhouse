<%= form_with model: staff_member, class: "row g-3" do |f| %>
  <%= render "shared/error_messages", object: staff_member %>

  <div class="col-md-6">
    <%= f.label :full_name, class: "form-label" %>
    <%= f.text_field :full_name, class: "form-control #{"is-invalid" if staff_member.errors[:full_name].any?}" %>
    <% staff_member.errors[:full_name].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-md-6">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: "form-control #{"is-invalid" if staff_member.errors[:role].any?}" %>
    <% staff_member.errors[:role].each do |message| %><div class="invalid-feedback"><%= message %></div><% end %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit class: "btn btn-coral" %>
    <%= link_to "Cancel", (staff_member.persisted? ? staff_member : staff_members_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
