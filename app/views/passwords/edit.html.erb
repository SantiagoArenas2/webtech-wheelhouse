<% content_for :title, "Reset password | Wheelhouse" %>
<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <p class="eyebrow">Workshop team</p>
      <h1 class="h2 mb-4">Update your password</h1>
      <%= form_with url: password_path(params[:token]), method: :put, class: "row g-3" do |form| %>
        <div class="col-12">
          <%= form.label :password, "New password", class: "form-label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10,
            maxlength: 72, class: "form-control" %>
          <div class="form-text">Use at least 10 characters.</div>
        </div>
        <div class="col-12">
          <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            maxlength: 72, class: "form-control" %>
        </div>
        <div class="col-12"><%= form.submit "Save password", class: "btn btn-coral" %></div>
      <% end %>
    </div>
  </div>
</section>
