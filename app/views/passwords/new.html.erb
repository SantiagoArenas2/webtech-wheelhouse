<% content_for :title, "Forgot password | Wheelhouse" %>
<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <p class="eyebrow">Workshop team</p>
      <h1 class="h2 mb-3">Forgot your password?</h1>
      <p class="text-muted">Enter your email address and, if it belongs to an account, we will send reset instructions.</p>
      <%= form_with url: passwords_path, class: "row g-3" do |form| %>
        <div class="col-12">
          <%= form.label :email_address, "Email address", class: "form-label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address], class: "form-control" %>
        </div>
        <div class="col-12"><%= form.submit "Email reset instructions", class: "btn btn-coral" %></div>
      <% end %>
      <%= link_to "Back to sign in", new_session_path, class: "d-inline-block mt-4" %>
    </div>
  </div>
</section>
