# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/config/master.key

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep
!/tmp/pids/

# Ignore uploaded files in development.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
.byebug_history

# Ignore node_modules
node_modules/

# Ignore precompiled javascript packs
/public/packs
/public/packs-test
/public/assets

# Ignore byebug command history file.
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

/.bundle
/vendor/bundle

/public/assets/builds
/app/assets/builds/*
!/app/assets/builds/.keep

.DS_Store
